{
    "name": "datatables.net-cardview-zf",
    "description": "CardView for DataTables with styling for [Foundation](https://get.foundation/)",
    "main": "./js/cardView.foundation.js",
    "module": "./js/cardView.foundation.mjs",
    "style": "./css/cardView.foundation.css",
    "types": "./types/cardView.foundation.d.ts",
    "version": "1.0.3",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Cards",
        "Responsive",
        "Foundation",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-cardview": "1.0.3",
        "datatables.net-zf": "^3"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "SEE LICENSE IN License.txt",
    "exports": {
        ".": {
            "types": "./types/cardView.foundation.d.ts",
            "import": "./js/cardView.foundation.mjs",
            "default": "./js/cardView.foundation.mjs",
            "require": "./js/cardView.foundation.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/cardView.foundation.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}